# ==============================================================================
# Atypical Speech Emergency Assistant — Application Environment Configuration
# ==============================================================================
# NOTE: This application is a strictly local controlled research demonstration.
# No external API keys, secrets, or cloud services are required or used.
# All paths and network bindings must remain bound to local loopback (127.0.0.1).
# ==============================================================================

# Server Network Settings
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=false

# Audio Upload & Stream Boundaries
APP_MAX_UPLOAD_BYTES=10485760       # 10 MB maximum upload size
APP_MAX_AUDIO_DURATION=30.0         # 30 seconds maximum audio duration
APP_SAMPLE_RATE=16000               # 16 kHz mono canonical sample rate

# Local Whisper Feature Extraction
APP_WHISPER_MODEL=openai/whisper-tiny
APP_DEVICE=cpu

# Default Demonstration Persona & Model
APP_DEFAULT_SPEAKER=F01
APP_DEFAULT_MODEL_ID=qsvc_q8_r1

# Operating Point & Decision Threshold Policy
# NOTE: tau = 0.6000 is an uncalibrated demonstration default.
# It is strictly decoupled from the internal 15% FER research evaluation ceiling.
APP_DEFAULT_TAU=0.6000
APP_FER_CEILING=0.1500

# Research Governance Disclaimer Mode
APP_ENFORCE_DISCLAIMER=true
APP_ENABLE_SYNTHETIC_BENCHMARK=true
